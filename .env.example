# Copy to .env for local development. Do not commit .env.

POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot
POSTGRES_DB=finpilot
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://finpilot:finpilot@localhost:5432/finpilot

# LLM (backend). Use stub without keys, a single provider (groq/gemini/openai), or smart routing.
# LLM_PROVIDER=auto tries LLM_ROUTE_ORDER in sequence; falls back on rate limits / 502–504.
LLM_PROVIDER=stub
LLM_ROUTE_ORDER=groq,gemini,openai,stub

GROQ_API_KEY=
# Groq retired llama-3.3-70b-versatile (Aug 2026); see console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Legacy single-provider setup (still supported when LLM_PROVIDER=groq|gemini|openai)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# Embeddings (RAG). Default stub works without a key; use openai with LLM_API_KEY set.
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Frontend: leave empty in dev (Vite proxies /api → backend). Set for static hosting.
VITE_API_URL=

# Optional override for the Vite dev/preview proxy target.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
