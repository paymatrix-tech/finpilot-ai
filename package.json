{
  "name": "finpilot-ai",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && cd backend && ../.venv/bin/alembic upgrade head && ../.venv/bin/python -m app.seed",
    "setup": "bash scripts/bootstrap.sh",
    "setup:fresh": "bash scripts/fresh-install.sh",
    "verify": "bash scripts/verify-setup.sh",
    "dev:api": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --prefix frontend",
    "test:api": "cd backend && ../.venv/bin/pytest -q"
  }
}
